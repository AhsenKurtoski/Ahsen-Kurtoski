# Copia questo file in `.env.local` e compila i valori.
# In produzione (es. Vercel) impostale tra le Environment Variables.

# Dominio del sito: usato per canonical, sitemap, robots.txt e Open Graph.
# Indirizzo ufficiale del sito:
# NEXT_PUBLIC_SITE_URL=https://axsenkurtoski.vercel.app
# Sviluppo locale:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Codice di verifica Google Search Console (GUIDA-SEO.md, passo 1)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Form di contatto (facoltativo ma consigliato) ---
# Crea una API key gratuita su https://resend.com/api-keys e incollala qui.
# Senza questa chiave il form mostra un messaggio e resta il link mailto.
RESEND_API_KEY=

# Dove ricevere i messaggi (default: usa l'email in src/lib/site.ts)
CONTACT_EMAIL=axsen.kurtoski@financier.com

# Mittente mostrato nelle email. Lascia vuoto per usare il mittente di prova di
# Resend (onboarding@resend.dev). Con un dominio verificato su Resend usa
# qualcosa come "Sito Axsen <no-reply@tuo-dominio.com>".
CONTACT_FROM=

# Chiave IndexNow (facoltativa: se assente viene generata in .indexnow-key)
# INDEXNOW_KEY=
