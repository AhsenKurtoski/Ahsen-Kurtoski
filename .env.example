# Copia questo file in `.env.local` e compila i valori.
# In produzione (es. Vercel) impostale tra le Environment Variables.

# Dominio del sito: usato per canonical, sitemap, robots.txt e Open Graph.
# Indirizzo ufficiale del sito:
# NEXT_PUBLIC_SITE_URL=https://ahsenkurtoski.vercel.app
# Sviluppo locale:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Codice di verifica Google Search Console (GUIDA-SEO.md, passo 1)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Google tag / Google Analytics 4 (facoltativo, formato G-XXXXXXXXXX).
# Se il valore è presente il sito chiede il consenso (Accetta/Rifiuta) e carica
# il tag SOLO dopo «Accetta»; la scelta si cambia dalla pagina privacy.
# Se il valore resta vuoto non viene caricato nulla e non c'è nessun consenso
# da chiedere. Dopo averlo attivato, aggiorna privacyUpdated in src/lib/site.ts.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Form di contatto (FormSubmit: nessuna API key) ---
# Indirizzo che riceve i messaggi del form. È anche l'email mostrata sul sito.
# Alla prima richiesta FormSubmit manda un'email di conferma: clicca il link
# una volta sola, poi i messaggi arrivano normalmente.
# Verifica in ogni momento con: npm run email:test
CONTACT_EMAIL=cshop0784@gmail.com

# Solo per collaudare il codice senza chiamare il servizio esterno.
# FORMSUBMIT_ENDPOINT=http://localhost:3399/ajax

# Chiave IndexNow (facoltativa: se assente viene generata in .indexnow-key)
# INDEXNOW_KEY=
